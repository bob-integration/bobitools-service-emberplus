{
  "license": "GPL-3.0-or-later",
  "id": "emberplus",
  "label": "Ember+",
  "version": "0.20.0",
  "description": "Provider Ember+ générique — agrège les contributions des outils déclarant `ember: true` et les expose en Ember+ S101 (TCP). Compatible VSM et autres contrôleurs broadcast. Sans authentification → à filtrer au niveau réseau.",
  "settings_keys": {
    "emberplus_enabled": {
      "type": "bool",
      "default": false
    },
    "emberplus_port": {
      "type": "int",
      "default": 9000
    },
    "emberplus_push_interval": {
      "type": "int",
      "default": 5
    },
    "emberplus_slots_count": {
      "type": "int",
      "default": 16
    },
    "emberplus_lanes_per_slot": {
      "type": "int",
      "default": 32
    },
    "emberplus_write_allow": {
      "type": "text",
      "default": ""
    },
    "emberplus_lazy_dir": {
      "type": "bool",
      "default": true
    },
    "emberplus_notify_token": {
      "type": "text",
      "default": ""
    }
  }
}